					<param>
						<name>Step</name>
						<type>RANGED_INTEGER</type>
						<minimum>-200</minimum>
						<maximum>200</maximum>
					</param>
				</params>
			</command>
			<command>
				<name>Set Entertainment Area</name>
				<description>Sync NAME to the entertainment area PARAM1</description>
				<sort_order>8</sort_order>
				<params>
					<param>
						<name>Area</name>
						<type>DYNAMIC_LIST</type>
					</param>
				</params>
			</command>
			<command>
				<name>Apply Sync Settings</name>
