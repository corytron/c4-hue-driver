		<!-- The actions of stage 2 (docs/hdmi-sync-stage2-design.md §5, contracts
		     C1.5), Set Source Sync Mode of stage 3
		     (docs/hdmi-sync-stage3-design.md §5) and Sync Box Settings of stage 4
		     (docs/hdmi-sync-stage4-design.md §1.4). Box, What and Source are
		     CUSTOM_SELECT lists built on demand by SyncBoxList,
		     SyncBoxSettingsList and SourceList in driver.lua [verified: FUND
		     12.3_custom_select_implementation/_1-Overview.md: "available for both
		     actions and commands", _2-CUSTOMSELECTLIST.md]: contracts C1.5's
		     DYNAMIC_LIST, in the form this driver's pickers take; Address is a
		     STRING [verified: FUND 9_commands/_1-COMMANDS.md]. -->
		<actions>
			<action>
				<name>Pair Sync Box</name>
				<command>Pair Sync Box</command>
				<sort_order>1</sort_order>
				<params>
					<param>
						<name>Box</name>
						<type>CUSTOM_SELECT:SyncBoxList</type>
					</param>
					<param>
						<name>Address</name>
						<type>STRING</type>
					</param>
				</params>
			</action>
			<!-- Design 5.4, O4, O18: the box's own input switching and CEC power
			     behaviours turned off with one click while Control4 routes through
			     the box, and restored exactly as they were with another; never
			     changed by themselves (syncbox/offers.lua). -->
			<action>
				<name>Sync Box Settings</name>
				<command>Sync Box Settings</command>
				<sort_order>2</sort_order>
				<params>
					<param>
						<name>What</name>
						<type>CUSTOM_SELECT:SyncBoxSettingsList</type>
					</param>
				</params>
			</action>
			<!-- Research §7.2: the sync mode of one source behind a receiver or on a
			     second output; the sources are those found upstream of the box and
			     those seen in the followed room. -->
			<action>
				<name>Set Source Sync Mode</name>
				<command>Set Source Sync Mode</command>
				<sort_order>3</sort_order>
				<params>
					<param>
						<name>Source</name>
						<type>CUSTOM_SELECT:SourceList</type>
					</param>
					<param>
						<name>Mode</name>
						<type>LIST</type>
						<items>
							<item>Automatic</item>
							<item>Video</item>
							<item>Game</item>
							<item>Music</item>
							<item>Do not sync</item>
						</items>
						<default>Automatic</default>
					</param>
				</params>
			</action>
			<action>
				<name>Diagnostics</name>
				<command>Diagnostics</command>
				<sort_order>4</sort_order>
				<params>
					<param>
						<name>What</name>
						<type>LIST</type>
						<items>
							<item>Check the box now</item>
							<item>Read everything from the box now</item>
							<item>Show the box's raw state in the Lua output</item>
						</items>
						<default>Check the box now</default>
					</param>
				</params>
			</action>
			<action>
				<name>Forget Pairing</name>
				<command>Forget Pairing</command>
				<sort_order>5</sort_order>
				<params>
					<param>
						<name>Confirm</name>
						<type>LIST</type>
						<items>
							<item>No</item>
							<item>Yes</item>
						</items>
						<default>No</default>
					</param>
				</params>
			</action>
		</actions>
		<!-- Contracts C1.6 (docs/hdmi-sync-stage4-design.md §1.1, §3): programming
		     refers to a command by its name, so names and parameters never change
		     once released [verified: FUND 14_updating_released_drivers/_2];
		     sort_order zero-based on every command [verified: FUND 9_commands/
		     _1-COMMANDS.md]. Area is a DYNAMIC_LIST, answered by
		     GetCommandParamList in driver.lua (OS 3.3.0, this driver's minimum)
		     [verified: FUND 9/_1, "Dynamic List type for Commands"]. Apply Sync
		     Settings sends every field it is given in one PUT, the mode before
		     the intensity (contracts C1.6): Leave leaves that field as the box
		     has it, so each field is optional; Brightness goes in steps of 10
		     there (Set Brightness takes any whole number). -->
		<commands>
			<command>
				<name>Start Sync</name>
				<description>Start syncing NAME, with the period's intensity and brightness</description>
				<sort_order>0</sort_order>
			</command>
			<command>
				<name>Stop Sync</name>
				<description>Stop syncing NAME and keep the picture</description>
				<sort_order>1</sort_order>
			</command>
			<command>
				<name>Toggle Sync</name>
