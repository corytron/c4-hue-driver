						<items>
							<item>Leave</item>
							<item>Subtle</item>
							<item>Moderate</item>
							<item>High</item>
							<item>Intense</item>
						</items>
					</param>
					<param>
						<name>Brightness</name>
						<type>LIST</type>
						<items>
							<item>Leave</item>
							<item>0 %</item>
							<item>10 %</item>
							<item>20 %</item>
							<item>30 %</item>
							<item>40 %</item>
							<item>50 %</item>
							<item>60 %</item>
							<item>70 %</item>
							<item>80 %</item>
							<item>90 %</item>
							<item>100 %</item>
							<item>110 %</item>
							<item>120 %</item>
							<item>130 %</item>
