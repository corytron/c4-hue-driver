					<item>Dynamic</item>
				</items>
				<default>As set in Hue</default>
				<readonly>false</readonly>
			</property>
			<!-- What the tile and the keypad LEDs follow: the scene's room or zone
			     lights as well as the scene, or the scene alone
			     (docs/scene-led-design.md). -->
			<property>
				<name>On State Follows</name>
				<type>LIST</type>
				<items>
