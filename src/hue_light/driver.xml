	</proxies>
	<!-- Color and color temperature are switched on per light at runtime with
	     DYNAMIC_CAPABILITIES_CHANGED once the bridge reports what the bulb supports.
	     reduced_als_support admits the light to Advanced Lighting Scenes, which then
	     drive it with SET_BRIGHTNESS_TARGET / SET_COLOR_TARGET; the proxy reference
	     asks reduced-ALS drivers to declare supports_brightness_stop so scene ramps
	     end correctly, and SET_COLOR_STOP "requires the capability supports_color_stop"
	     (named only there; dropped if Composer objects). -->
	<capabilities>
		<dimmer>True</dimmer>
		<set_level>True</set_level>
		<ramp_level>True</ramp_level>
		<on_off>True</on_off>
		<min_max>False</min_max>
		<click_rates>True</click_rates>
		<click_rate_min>0</click_rate_min>
		<hold_rates>True</hold_rates>
		<hold_rate_min>1000</hold_rate_min>
		<supports_default_on>True</supports_default_on>
		<cold_start>False</cold_start>
		<has_leds>True</has_leds>
		<supports_target>True</supports_target>
		<supports_brightness_stop>True</supports_brightness_stop>
		<supports_color_stop>True</supports_color_stop>
		<supports_color>False</supports_color>
		<supports_color_correlated_temperature>False</supports_color_correlated_temperature>
		<supports_broadcast_scenes>False</supports_broadcast_scenes>
		<supports_multichannel_scenes>False</supports_multichannel_scenes>
		<hide_proxy_properties>False</hide_proxy_properties>
		<hide_proxy_events>False</hide_proxy_events>
		<reduced_als_support>True</reduced_als_support>
		<advanced_scene_support>False</advanced_scene_support>
		<load_group_support>False</load_group_support>
		<buttons_are_virtual>True</buttons_are_virtual>
	</capabilities>
